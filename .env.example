# ---------------------------------------------------------------------------
# Cloud SQL for PostgreSQL (the instance backing Firebase Data Connect)
#
# Connect as the non-owner runtime role created in 0003_rls.sql. Using the
# owner role here silently disables every RLS policy.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://inbound_app:PASSWORD@HOST:5432/inbound
PGSSLMODE=                          # set to "disable" only for a local Postgres
PGPOOL_MAX=10

# ---------------------------------------------------------------------------
# Firebase Auth
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only. Omit on Cloud Run / Firebase App Hosting, where Application
# Default Credentials are used instead. Paste the service account JSON verbatim.
FIREBASE_SERVICE_ACCOUNT_KEY=

# ---------------------------------------------------------------------------
# Mapbox
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=

# ---------------------------------------------------------------------------
# MBTA V3 (unauthenticated works but is heavily rate-limited)
# ---------------------------------------------------------------------------
MBTA_API_KEY=

# ---------------------------------------------------------------------------
# Google Places (server-only; photo URLs are proxied through /api/photos)
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# Upstash Redis (optional - caching degrades gracefully when unset)
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
