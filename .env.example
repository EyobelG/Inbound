# ---------------------------------------------------------------------------
# Cloud SQL for PostgreSQL (the instance backing Firebase Data Connect)
#
# Connect as the non-owner runtime role created in 0003_rls.sql. Using the
# owner role here silently disables every RLS policy.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://inbound_app:PASSWORD@HOST:5432/inbound
PGSSLMODE=                          # set to "disable" only for a local Postgres
PGSSLROOTCERT=                      # only needed for a private-CA provider (e.g. real Cloud
                                     # SQL). Neon's cert is publicly trusted (Let's Encrypt),
                                     # already in Node's default trust store - leave this unset.
PGPOOL_MAX=10

# ---------------------------------------------------------------------------
# Firebase Auth
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-only. Omit on Cloud Run / Firebase App Hosting, where Application
# Default Credentials are used instead. Paste the service account JSON verbatim.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Signing secret for short-lived, scoped app tokens (src/lib/auth/appToken.ts),
# minted from a verified Firebase token and required by write routes in
# addition to RLS. Server-only. Generate with: openssl rand -base64 32
APP_TOKEN_SECRET=

# ---------------------------------------------------------------------------
# Map basemap
#
# No key required. The map uses MapLibre GL with OpenFreeMap vector tiles,
# which are free and unmetered. Set this only to override the basemap with a
# different MapLibre style URL (self-hosted Protomaps, a paid provider, etc).
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_MAP_STYLE=https://tiles.openfreemap.org/styles/dark

# ---------------------------------------------------------------------------
# MBTA V3 (unauthenticated works but is heavily rate-limited)
# ---------------------------------------------------------------------------
MBTA_API_KEY=

# ---------------------------------------------------------------------------
# Google Places (server-only; photo URLs are proxied through /api/photos)
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=

# ---------------------------------------------------------------------------
# Upstash Redis (optional - caching degrades gracefully when unset)
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
